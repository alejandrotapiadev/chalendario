# API
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# Permite crear cuentas nuevas. Ponlo en false cuando ya tengas la tuya.
REGISTRATION_OPEN=true

# Límite de intentos en login/registro (10 por minuto y IP). Se desactiva en las pruebas E2E.
RATE_LIMIT=true

# Ponlo en true solo si hay un proxy inverso de confianza delante (nginx, balanceador…),
# para que el límite de intentos cuente la IP real del cliente y no la del proxy.
TRUST_PROXY=false

# Coste de scrypt para las contraseñas: en producción usa siempre el recomendado por OWASP.
# Las pruebas E2E lo bajan para no agotar el hilo de cifrado con varios registros a la vez.
SCRYPT_FAST=false

# PostgreSQL (docker-compose.yml expone 5432)
DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar

# Base de datos usada por los tests de integración
TEST_DATABASE_URL=postgres://calendar:calendar@localhost:5432/calendar_test
