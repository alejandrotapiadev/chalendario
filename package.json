{
  "name": "personal-calendar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @calendar/api dev",
    "dev:web": "pnpm --filter @calendar/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "migrate": "node-pg-migrate --migrations-dir migrations --migration-file-language sql --database-url-var DATABASE_URL",
    "migrate:up": "pnpm migrate up",
    "migrate:down": "pnpm migrate down",
    "migrate:create": "pnpm migrate create"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
